# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
TZ=America/Bogota

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=nexory_super_secret_jwt_key_change_in_production_2024
JWT_EXPIRES_IN=24h

# ─── CORS ────────────────────────────────────────────────────────────────────
# URL del frontend (ajustar si cambias el puerto)
FRONTEND_URL=http://localhost:5001

# ─── Encryption (AES-256 for MikroTik passwords) ─────────────────────────────
ENCRYPTION_KEY=nexory_aes256_key_change_in_production_32chars!

# ─── PostgreSQL (Azure) ───────────────────────────────────────────────────────
# ⚠️  Tu IP debe estar en la whitelist de Azure PostgreSQL
# Azure Portal → nexory-db-server → Networking → Add current client IP
DATABASE_URL="postgresql://nexoryadmin:Yeily12345*@nexory-db-server.postgres.database.azure.com:5432/nexory_db?schema=public&sslmode=require"

# ─── MikroTik RouterOS API ───────────────────────────────────────────────────
# ▸ Red local:  MIKROTIK_HOST=192.168.1.200  (mismo WiFi/LAN que el router)
# ▸ Remoto:     MIKROTIK_HOST=<IP pública>   (requiere port-forward puerto 8728)
MIKROTIK_HOST=192.168.1.200
MIKROTIK_USER=admin
MIKROTIK_PASS=admin
MIKROTIK_PORT=8728

# ─── WhatsApp via WAHA (Azure Container) ─────────────────────────────────────
WAHA_BASE_URL=http://nexory-waha.eastus2.azurecontainer.io:3000
WAHA_API_KEY=nexory-waha-2024
WAHA_SESSION=default

# ─── Email (SMTP Gmail) ──────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notificacionesnexory@gmail.com
SMTP_PASS=ggqkrxcumpdozzkr
SMTP_FROM=Nexory ISP <notificacionesnexory@gmail.com>
